// Esquema de la base de datos unificada — Sistema de Gestión ISFDyT N.° 26
//
// Es el reflejo en tablas de shared/types.ts (mismos nombres y códigos).
// Si cambiás algo acá, actualizá también shared/types.ts.
//
// Comandos (desde la raíz del repo):
//   npm run db:migrate   crea una migración nueva en local (prisma migrate dev)
//   npm run db:deploy    aplica las migraciones en Neon (prisma migrate deploy)
//   npm run db:generate  regenera el cliente de Prisma

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Catálogos
// ============================================================================

enum Role {
  SUPER_ADMIN
  DIRECTOR
  ADMINISTRATIVE
  PRECEPTOR
  TEACHER
  STUDENT
  STAFF
  STUDENT_REP
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Shift {
  MORNING
  AFTERNOON
  EVENING
}

enum AcademicPeriod {
  FIRST_TERM
  SECOND_TERM
  ANNUAL
}

enum CycleStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum EnrollmentCondition {
  IN_PROGRESS
  REGULAR
  FREE
  PROMOTED
  PASSED
  DROPPED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum AttendanceSource {
  TEACHER
  PRECEPTOR
  QR
  IMPORT
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum JustificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AssessmentType {
  PARTIAL
  MAKEUP
  ASSIGNMENT
  COLLOQUIUM
  FINAL_EXAM
}

enum ObservationCategory {
  PEDAGOGICAL_FOLLOW_UP
  PARTICIPATION
  SUPPORT_ADJUSTMENT
  GENERAL
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum NoticeCategory {
  URGENT
  INSTITUTIONAL
  PEDAGOGICAL
  ACADEMIC
}

enum EventType {
  INSTITUTIONAL_DAY
  CEREMONY
  EXAM_PERIOD
  GRADES_DEADLINE
  HOLIDAY
  CLASS
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  STATUS_CHANGE
  DELETE
  SETTINGS_CHANGE
  EXPORT
  LOGIN
  SESSION_REOPEN
}

// ============================================================================
// Identidad y acceso
// ============================================================================

/// Cuenta de ingreso. Las crea el panel de Directivos (no hay registro libre).
model User {
  id                 String     @id @default(uuid()) @db.Uuid
  /// Se guarda en minúsculas.
  email              String     @unique
  firstName          String
  lastName           String
  roles              Role[]
  status             UserStatus @default(ACTIVE)
  passwordHash       String
  /// true al crear la cuenta o al blanquear la contraseña: el usuario debe cambiarla al entrar.
  mustChangePassword Boolean    @default(true)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdById        String?    @db.Uuid
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions AuthSession[]
  student  Student?
  teacher  Teacher?

  repThreads       RepThread[]
  repReplies       RepReply[]
  repAnnouncements RepAnnouncement[]
  repClaims        RepClaim[]            @relation("ClaimAuthor")
  repEvents        RepEventParticipant[]

  profile          UserProfile?
  notes            UserNote[]
  messagesSent     PrivateMessage[] @relation("MessagesSent")
  messagesReceived PrivateMessage[] @relation("MessagesReceived")
  forumThreads     ForumThread[]    @relation("ForumAuthor")
  forumReplies     ForumReply[]     @relation("ForumReplyAuthor")
  notifications    Notification[]

  @@map("users")
}

/// Sesión de ingreso. El navegador guarda un token en una cookie HttpOnly;
/// acá se guarda solo su hash (SHA-256), nunca el token.
model AuthSession {
  id         String   @id // hash del token
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?

  @@index([userId])
  @@map("auth_sessions")
}

// ============================================================================
// Estructura académica (modelo terciario)
// ============================================================================

model Career {
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @unique
  name          String
  durationYears Int
  active        Boolean     @default(true)
  /// true = dato de ejemplo (npm run db:demo-data); se borra con db:demo-data:off
  demo          Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  plans         StudyPlan[]
  students      Student[]

  @@map("careers")
}

model StudyPlan {
  id        String    @id @default(uuid()) @db.Uuid
  careerId  String    @db.Uuid
  career    Career    @relation(fields: [careerId], references: [id])
  code      String    @unique
  name      String
  startYear Int
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  subjects  Subject[]
  students  Student[]

  @@map("study_plans")
}

model Subject {
  id            String         @id @default(uuid()) @db.Uuid
  planId        String         @db.Uuid
  plan          StudyPlan      @relation(fields: [planId], references: [id])
  code          String
  name          String
  year          Int
  period        AcademicPeriod
  weeklyHours   Int?
  /// Correlativas: materias que hay que tener antes.
  prerequisites Subject[]      @relation("Prerequisites")
  requiredBy    Subject[]      @relation("Prerequisites")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  commissions   Commission[]

  @@unique([planId, code])
  @@map("subjects")
}

model AcademicCycle {
  id               String        @id @default(uuid()) @db.Uuid
  year             Int           @unique
  status           CycleStatus   @default(PLANNED)
  startDate        DateTime      @db.Date
  endDate          DateTime      @db.Date
  firstTermEndDate DateTime?     @db.Date
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  commissions      Commission[]
  notices          Notice[]
  events           SchoolEvent[]

  @@map("academic_cycles")
}

model Commission {
  id              String              @id @default(uuid()) @db.Uuid
  code            String
  cycleId         String              @db.Uuid
  cycle           AcademicCycle       @relation(fields: [cycleId], references: [id])
  subjectId       String              @db.Uuid
  subject         Subject             @relation(fields: [subjectId], references: [id])
  period          AcademicPeriod
  shift           Shift
  preceptorUserId String?             @db.Uuid
  /// ScheduleSlot[] de shared/types.ts
  schedule        Json                @default("[]")
  capacity        Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  teachers        CommissionTeacher[]
  enrollments     Enrollment[]
  sessions        ClassSession[]
  observations    Observation[]
  events          SchoolEvent[]

  @@unique([cycleId, code])
  @@map("commissions")
}

/// Docentes de una comisión; position 0 = titular.
model CommissionTeacher {
  commissionId String     @db.Uuid
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  teacherId    String     @db.Uuid
  teacher      Teacher    @relation(fields: [teacherId], references: [id])
  position     Int        @default(0)

  @@id([commissionId, teacherId])
  @@map("commission_teachers")
}

// ============================================================================
// Personas
// ============================================================================

model Student {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String?               @unique @db.Uuid
  user           User?                 @relation(fields: [userId], references: [id])
  fileNumber     String                @unique
  dni            String                @unique
  firstName      String
  lastName       String
  email          String
  phone          String?
  careerId       String                @db.Uuid
  career         Career                @relation(fields: [careerId], references: [id])
  planId         String                @db.Uuid
  plan           StudyPlan             @relation(fields: [planId], references: [id])
  admissionDate  DateTime              @db.Date
  status         StudentStatus         @default(ACTIVE)
  demo           Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  sensitive      StudentSensitiveData?
  enrollments    Enrollment[]
  attendance     AttendanceRecord[]
  justifications Justification[]
  observations   Observation[]

  @@map("students")
}

/// Datos sensibles (Ley 25.326): tabla aparte, acceso solo para roles autorizados.
model StudentSensitiveData {
  studentId             String    @id @db.Uuid
  student               Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  birthDate             DateTime? @db.Date
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactEmail String?
  healthNotes           String?
  updatedAt             DateTime  @updatedAt

  @@map("student_sensitive_data")
}

model Teacher {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String?             @unique @db.Uuid
  user        User?               @relation(fields: [userId], references: [id])
  fileNumber  String              @unique
  dni         String              @unique
  firstName   String
  lastName    String
  email       String
  phone       String?
  title       String?
  status      TeacherStatus       @default(ACTIVE)
  demo        Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  commissions CommissionTeacher[]

  @@map("teachers")
}

// ============================================================================
// Inscripciones, asistencia, notas
// ============================================================================

model Enrollment {
  id                 String              @id @default(uuid()) @db.Uuid
  studentId          String              @db.Uuid
  student            Student             @relation(fields: [studentId], references: [id])
  commissionId       String              @db.Uuid
  commission         Commission          @relation(fields: [commissionId], references: [id])
  condition          EnrollmentCondition @default(IN_PROGRESS)
  enrolledAt         DateTime            @default(now()) @db.Date
  conditionChangedAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  grades             Grade[]

  @@unique([studentId, commissionId])
  @@map("enrollments")
}

model ClassSession {
  id           String             @id @default(uuid()) @db.Uuid
  commissionId String             @db.Uuid
  commission   Commission         @relation(fields: [commissionId], references: [id])
  date         DateTime           @db.Date
  topic        String?
  status       SessionStatus      @default(OPEN)
  closedAt     DateTime?
  closedBy     String?            @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  records      AttendanceRecord[]

  @@index([commissionId, date])
  @@map("class_sessions")
}

model AttendanceRecord {
  id          String           @id @default(uuid()) @db.Uuid
  sessionId   String           @db.Uuid
  session     ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId   String           @db.Uuid
  student     Student          @relation(fields: [studentId], references: [id])
  status      AttendanceStatus
  minutesLate Int?
  notes       String?
  source      AttendanceSource
  recordedBy  String           @db.Uuid
  recordedAt  DateTime         @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@map("attendance_records")
}

model Justification {
  id          String              @id @default(uuid()) @db.Uuid
  studentId   String              @db.Uuid
  student     Student             @relation(fields: [studentId], references: [id])
  fromDate    DateTime            @db.Date
  toDate      DateTime            @db.Date
  reason      String
  documentUrl String?
  status      JustificationStatus @default(PENDING)
  createdBy   String              @db.Uuid
  reviewedBy  String?             @db.Uuid
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([studentId, fromDate, toDate])
  @@map("justifications")
}

model Grade {
  id           String         @id @default(uuid()) @db.Uuid
  enrollmentId String         @db.Uuid
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id])
  type         AssessmentType
  instance     Int            @default(1)
  date         DateTime       @db.Date
  value        Decimal?       @db.Decimal(4, 2)
  absent       Boolean        @default(false)
  published    Boolean        @default(false)
  publishedAt  DateTime?
  notes        String?
  recordedBy   String         @db.Uuid
  recordedAt   DateTime       @default(now())

  @@unique([enrollmentId, type, instance])
  @@map("grades")
}

model Observation {
  id           String              @id @default(uuid()) @db.Uuid
  commissionId String              @db.Uuid
  commission   Commission          @relation(fields: [commissionId], references: [id])
  studentId    String              @db.Uuid
  student      Student             @relation(fields: [studentId], references: [id])
  date         DateTime            @db.Date
  category     ObservationCategory
  content      String
  createdBy    String              @db.Uuid
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("observations")
}

// ============================================================================
// Comunicación y control institucional
// ============================================================================

model Notice {
  id          String         @id @default(uuid()) @db.Uuid
  cycleId     String         @db.Uuid
  cycle       AcademicCycle  @relation(fields: [cycleId], references: [id])
  title       String
  content     String
  category    NoticeCategory
  /// NoticeAudience de shared/types.ts
  audience    Json           @default("{}")
  status      NoticeStatus   @default(DRAFT)
  pinned      Boolean        @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String         @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("notices")
}

model SchoolEvent {
  id           String        @id @default(uuid()) @db.Uuid
  cycleId      String        @db.Uuid
  cycle        AcademicCycle @relation(fields: [cycleId], references: [id])
  type         EventType
  title        String
  description  String?
  startDate    DateTime      @db.Date
  endDate      DateTime?     @db.Date
  commissionId String?       @db.Uuid
  commission   Commission?   @relation(fields: [commissionId], references: [id])
  mandatory    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("school_events")
}

/// Lo escribe solo el backend.
model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  at            DateTime    @default(now())
  userId        String?     @db.Uuid
  userName      String
  action        AuditAction
  entity        String
  entityId      String
  summary       String
  previousValue Json?
  newValue      Json?
  ip            String?

  @@index([entity, entityId])
  @@index([at])
  @@map("audit_logs")
}

/// Fila única (id = 1).
model InstitutionSettings {
  id                             Int      @id @default(1)
  name                           String
  shortName                      String
  cue                            String?
  city                           String
  district                       String
  timezone                       String   @default("America/Argentina/Buenos_Aires")
  minAttendancePercent           Int      @default(75)
  /// PENDIENTE de decisión institucional (decisión 6).
  lateArrivalAbsenceWeight       Decimal  @default(0) @db.Decimal(3, 2)
  attendanceRiskThresholdPercent Int      @default(80)
  updatedAt                      DateTime @updatedAt

  @@map("institution_settings")
}

// ============================================================================
// Auxiliares (maestranza / mantenimiento del edificio)
// ============================================================================

enum StaffTaskType {
  CLEANING
  MAINTENANCE
  ROUTINE
}

enum StaffTaskStatus {
  PENDING
  DONE
}

enum InstallationStatus {
  OK
  MAINTENANCE
  OUT_OF_SERVICE
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model StaffTask {
  id               String          @id @default(uuid()) @db.Uuid
  date             DateTime        @db.Date
  startTime        String
  title            String
  type             StaffTaskType
  status           StaffTaskStatus @default(PENDING)
  location         String
  details          String?
  assignedToUserId String?         @db.Uuid
  completedAt      DateTime?
  completedBy      String?         @db.Uuid
  createdBy        String          @db.Uuid
  demo             Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([date])
  @@map("staff_tasks")
}

model Installation {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @unique
  status          InstallationStatus @default(OK)
  /// { col, row, colSpan, rowSpan } en el plano del edificio
  layout          Json
  lastCleanedAt   DateTime?
  nextTask        String?
  notes           String?
  demo            Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  incidents       Incident[]
  maintenanceLogs MaintenanceLog[]

  @@map("installations")
}

model Incident {
  id             String           @id @default(uuid()) @db.Uuid
  description    String
  priority       IncidentPriority
  sector         String
  installationId String?          @db.Uuid
  installation   Installation?    @relation(fields: [installationId], references: [id])
  imageUrl       String?
  status         IncidentStatus   @default(OPEN)
  reportedBy     String           @db.Uuid
  resolvedAt     DateTime?
  resolvedBy     String?          @db.Uuid
  demo           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@map("incidents")
}

model MaintenanceLog {
  id             String        @id @default(uuid()) @db.Uuid
  date           DateTime      @db.Date
  task           String
  responsible    String
  installationId String?       @db.Uuid
  installation   Installation? @relation(fields: [installationId], references: [id])
  recordedBy     String        @db.Uuid
  demo           Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@map("maintenance_logs")
}

// ============================================================================
// Centro de Estudiantes
// ============================================================================

enum RepEventType {
  ACADEMIC
  CULTURAL
  SPORTS
  MEETING
}

enum RepForumCategory {
  GENERAL
  PROPOSALS
  EVENTS
}

enum RepClaimCategory {
  ACADEMIC
  INFRASTRUCTURE
  ADMINISTRATIVE
  SUGGESTION
}

enum RepClaimStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  ARCHIVED
}

model RepEvent {
  id           String                @id @default(uuid()) @db.Uuid
  title        String
  date         DateTime              @db.Date
  time         String?
  location     String?
  description  String
  type         RepEventType
  organizer    String
  createdBy    String                @db.Uuid
  demo         Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  participants RepEventParticipant[]

  @@index([date])
  @@map("rep_events")
}

model RepEventParticipant {
  eventId  String   @db.Uuid
  event    RepEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String   @db.Uuid
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([eventId, userId])
  @@map("rep_event_participants")
}

model RepThread {
  id        String           @id @default(uuid()) @db.Uuid
  authorId  String           @db.Uuid
  author    User             @relation(fields: [authorId], references: [id])
  title     String
  content   String
  category  RepForumCategory
  pinned    Boolean          @default(false)
  demo      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  replies   RepReply[]

  @@map("rep_threads")
}

model RepReply {
  id        String    @id @default(uuid()) @db.Uuid
  threadId  String    @db.Uuid
  thread    RepThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String    @db.Uuid
  author    User      @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime  @default(now())

  @@map("rep_replies")
}

model RepAnnouncement {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  content     String
  authorId    String    @db.Uuid
  author      User      @relation(fields: [authorId], references: [id])
  pinned      Boolean   @default(false)
  publishDate DateTime? @db.Date
  demo        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("rep_announcements")
}

model RepClaim {
  id          String           @id @default(uuid()) @db.Uuid
  authorId    String           @db.Uuid
  author      User             @relation("ClaimAuthor", fields: [authorId], references: [id])
  category    RepClaimCategory
  description String
  status      RepClaimStatus   @default(PENDING)
  response    String?
  responderId String?          @db.Uuid
  demo        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@map("rep_claims")
}

// ============================================================================
// Datos compartidos entre apps (perfil, notas, mensajes, foro, notificaciones)
// ============================================================================

/// Perfil visible de cada cuenta (lo ven las otras apps). Los datos sensibles del alumno
/// siguen en student_sensitive_data.
model UserProfile {
  userId       String   @id @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String?
  phone        String?
  avatarUrl    String?
  bannerUrl    String?
  accentColor  String?
  /// Cargo en el Centro de Estudiantes, si corresponde
  position     String?
  /// [{ id, url, label }]
  links        Json     @default("[]")
  /// [{ id, dayOfWeek, startTime, endTime }] — horarios de atención/consulta
  availability Json     @default("[]")
  updatedAt    DateTime @updatedAt

  @@map("user_profiles")
}

/// Notas personales (solo las ve su dueño).
model UserNote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  color     String   @default("yellow")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_notes")
}

model PrivateMessage {
  id         String    @id @default(uuid()) @db.Uuid
  senderId   String    @db.Uuid
  sender     User      @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String    @db.Uuid
  receiver   User      @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  text       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, readAt])
  @@map("private_messages")
}

enum ForumThreadStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_REVISION
}

/// Foro académico moderado (lo modera Preceptoría). El del Centro de Estudiantes es rep_threads.
model ForumThread {
  id              String            @id @default(uuid()) @db.Uuid
  authorId        String            @db.Uuid
  author          User              @relation("ForumAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title           String
  content         String
  careerId        String?           @db.Uuid
  year            Int?
  commissionId    String?           @db.Uuid
  status          ForumThreadStatus @default(PENDING)
  rejectionReason String?
  locked          Boolean           @default(false)
  moderatedBy     String?           @db.Uuid
  moderatedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  replies         ForumReply[]

  @@index([status])
  @@map("forum_threads")
}

model ForumReply {
  id        String      @id @default(uuid()) @db.Uuid
  threadId  String      @db.Uuid
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String      @db.Uuid
  author    User        @relation("ForumReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime    @default(now())

  @@map("forum_replies")
}

enum NotificationType {
  ANNOUNCEMENT
  ABSENCE
  JUSTIFICATION_REQUEST
  JUSTIFICATION_APPROVED
  JUSTIFICATION_REJECTED
  MESSAGE
  FORUM
  EVENT
  CLAIM
  GENERAL
}

/// Avisos por usuario. Los genera el backend (ej. al aprobar una justificación).
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  text      String
  details   String?
  /// Ruta o recurso relacionado (ej. "/attendance/justifications/<id>")
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}
