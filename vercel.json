{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/Lucia(.*)Alumnos/modulo(.*)alumno/modulo-alumno-documentacion/(.*)",
      "destination": "/alumnos-lucia/documentacion/$3",
      "permanent": true
    },
    {
      "source": "/Nicolas(.*)Profesores/(.*)",
      "destination": "/profesores-nicolas/$2",
      "permanent": true
    },
    {
      "source": "/Julian(.*)Alumnos/(.*)",
      "destination": "/ecosistema-julian/alumnos/$2",
      "permanent": true
    },
    {
      "source": "/alumnos-julian/:path*",
      "destination": "/ecosistema-julian/alumnos/:path*",
      "permanent": true
    },
    {
      "source": "/Lucia(.*)Alumnos/(.*)",
      "destination": "/alumnos-lucia/$2",
      "permanent": true
    },
    {
      "source": "/Jesica(.*)Directivos/(.*)",
      "destination": "/directivos-jesica-agustin/$2",
      "permanent": true
    },
    {
      "source": "/Benjamin(.*)Preceptor(.*)/(.*)",
      "destination": "/preceptoria-benjamin/$3",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/profesores-nicolas/app/:path*",
      "destination": "/profesores-nicolas/app/index.html"
    },
    {
      "source": "/directivos-jesica-agustin/app/:path*",
      "destination": "/directivos-jesica-agustin/app/index.html"
    },
    {
      "source": "/ecosistema-julian/alumnos/app/:path*",
      "destination": "/ecosistema-julian/alumnos/app/index.html"
    },
    {
      "source": "/ecosistema-julian/alumnos/app-v2/:path*",
      "destination": "/ecosistema-julian/alumnos/app-v2/index.html"
    },
    {
      "source": "/ecosistema-julian/centro/:path*",
      "destination": "/ecosistema-julian/centro/index.html"
    },
    {
      "source": "/ecosistema-julian/auxiliares/:path*",
      "destination": "/ecosistema-julian/auxiliares/index.html"
    },
    {
      "source": "/ecosistema-julian/preceptoria/:path*",
      "destination": "/ecosistema-julian/preceptoria/index.html"
    },
    {
      "source": "/alumnos-lucia/app/:path*",
      "destination": "/alumnos-lucia/app/index.html"
    },
    {
      "source": "/consolidacion/app/:path*",
      "destination": "/consolidacion/app/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    }
  }
}
