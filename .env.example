# ============================================================
# Backend del Sistema de Gestión — variables de entorno
# Copiar a .env (NO se sube al repo) y completar.
# En Vercel se cargan en Settings → Environment Variables.
# ============================================================

# Proveedor activo: Neon (decisión del usuario, 2026-10-28).
# Alternativa Supabase documentada en docs/SUPABASE.md; no está activada.
# Credenciales solo del servidor; jamás usar el prefijo VITE_ para estas cadenas.

# API: conexión pooled de Neon.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-PROYECTO-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Migraciones: conexión directa, sin -pooler.
DIRECT_DATABASE_URL="postgresql://USUARIO:CLAVE@ep-PROYECTO.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Solo en local, para "npm run db:migrate" (base vacía auxiliar de Prisma).
# SHADOW_DATABASE_URL="postgresql://postgres@localhost:5440/sga_shadow"

# Primera cuenta (superadministrador). La crea "npm run db:seed" una sola vez.
# Después de entrar, el sistema obliga a cambiar la contraseña.
SEED_ADMIN_EMAIL="direccion@isfdyt26.edu.ar"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"
SEED_ADMIN_FIRST_NAME="Administración"
SEED_ADMIN_LAST_NAME="ISFDyT 26"

# Duración de la sesión, en horas.
SESSION_TTL_HOURS=12
