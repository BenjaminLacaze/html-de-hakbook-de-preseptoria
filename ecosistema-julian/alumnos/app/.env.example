# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# ASISTENCIA TERCIARIO — CONFIGURACIÓN API
# ==========================================
# VITE_API_BASE_URL: URL del backend institucional. Ejemplo local únicamente.
# Confirmar la URL real con el equipo antes de desactivar el modo mock.
VITE_API_BASE_URL="http://localhost:4000/api/v1"

# VITE_USE_MOCK: 'true' para utilizar la capa desacoplada de datos de demostración
# o 'false' para conectar directamente con la API REST y base MySQL.
VITE_USE_MOCK="true"
